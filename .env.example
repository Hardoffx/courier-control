DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SQLITE_PATH=

# Production portal split. Keep 0 for local/dev and enable only after both
# hostnames are routed to the same app through Nginx/HTTPS.
DOMAIN_SPLIT_ENABLED=0
COURIER_HOST=courier.routecontrol.ru
CONTROL_HOST=control.routecontrol.ru

# Yandex Maps. Keep real keys out of Git.
# JS API 3.0 key must be restricted by the deployed HTTP Referer/domain.
YANDEX_MAPS_JS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_LANG=ru_RU

# Production PostgreSQL (future multi-server/concurrent stage):
# POSTGRES_DB=courier_control
# POSTGRES_USER=courier_control
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
