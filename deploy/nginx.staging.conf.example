# Add this server block beside the stable control.routecontrol.ru vhost.
# Obtain/attach TLS for staging.routecontrol.ru separately before enabling public access.
server {
    listen 80;
    listen [::]:80;
    server_name staging.routecontrol.ru;
    client_max_body_size 6m;

    location /static/ {
        alias /opt/courier-control-staging/staticfiles/;
        expires 5m;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}
