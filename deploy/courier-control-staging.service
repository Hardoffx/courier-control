[Unit]
Description=Courier Control staging
After=network.target

[Service]
Type=simple
User=courierctl
Group=courierctl
WorkingDirectory=/opt/courier-control-staging
EnvironmentFile=/opt/courier-control-staging/.env
ExecStart=/opt/courier-control-staging/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8011 --workers 2 --timeout 60 --access-logfile - --error-logfile -
Restart=always
RestartSec=3
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/courier-control-staging/data /opt/courier-control-staging/var /opt/courier-control-staging/backups

[Install]
WantedBy=multi-user.target
